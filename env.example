# Copie para .env na raiz para usar o Docker Compose. O .env não vai para o Git.
# Gere um valor DIFERENTE para cada segredo com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# O formato hexadecimal evita caracteres reservados na URL do PostgreSQL.
POSTGRES_USER=cryoflix
POSTGRES_DB=cryoflix
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

TMDB_API_KEY=
OPENSUBTITLES_API_KEY=

# Preencha antes de criar/atualizar o administrador com o seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP é opcional em desenvolvimento. Sem SMTP, os links aparecem no log local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
