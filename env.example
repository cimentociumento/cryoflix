# Copie para backend/.env — este arquivo (env.example) vai pro git, o .env NÃO.

NODE_ENV=development
PORT=3333

# Postgres (bate com o docker-compose.yml)
DATABASE_URL=postgresql://cryoflix:cryoflix_dev@localhost:5432/cryoflix

# Redis
REDIS_URL=redis://localhost:6379

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque_isto_por_no_minimo_32_caracteres_aleatorios
JWT_ACCESS_TTL=15m
REFRESH_TTL_DIAS=30
BCRYPT_COST=12

# CORS — origem do frontend
CORS_ORIGIN=http://localhost:5173

# Cookie de refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
